{
  "name": "n8n-nodes-doclift",
  "version": "0.1.1",
  "description": "Generate PDF documents from Doclift templates",
  "license": "MIT",
  "homepage": "https://github.com/CapSens/n8n-nodes-doclift",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "doclift",
    "pdf",
    "document-generation"
  ],
  "author": {
    "name": "Ismael B.",
    "email": "ismael@capsens.eu"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CapSens/n8n-nodes-doclift.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/DocliftApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Doclift/Doclift.node.js",
      "dist/nodes/DocliftTrigger/DocliftTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "typescript": "5.9.2",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "bugs": {
    "url": "https://github.com/CapSens/n8n-nodes-doclift/issues"
  }
}
